# 依赖包（必须忽略，体积巨大，云端自动安装）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS/IDE本地缓存文件（绝对不要传）
.vs/
.idea/
*.sln
*.suo
*.user
*.slnx
*.csproj.user

# 环境变量/密钥文件（必须忽略，防止API密钥泄露）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 系统自动生成的垃圾文件（忽略）
.DS_Store
Thumbs.db
Desktop.ini

# 日志文件（忽略）
logs/
*.log

# 本地数据库文件
database.db

# 本地测试上传的图片
img-*.png
public/uploads/